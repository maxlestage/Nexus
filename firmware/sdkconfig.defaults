# Bluetooth dual mode : BR/EDR (HID classique pour la Switch) + BLE
# (service de configuration pour l'app iPhone, HID gamepad pour PC).
CONFIG_BT_ENABLED=y
CONFIG_BTDM_CTRL_MODE_BTDM=y
CONFIG_BT_BLUEDROID_ENABLED=y
CONFIG_BT_CLASSIC_ENABLED=y
CONFIG_BT_HID_ENABLED=y
CONFIG_BT_HID_DEVICE_ENABLED=y
CONFIG_BT_BLE_ENABLED=y
CONFIG_BT_GATTS_ENABLE=y
CONFIG_BT_SSP_ENABLED=y

# La pile BT + WiFi (OTA) demande de la place.
CONFIG_ESP_MAIN_TASK_STACK_SIZE=16384
CONFIG_PTHREAD_TASK_STACK_SIZE_DEFAULT=8192

# Partitions : deux slots OTA + NVS (voir partitions.csv).
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# 240 MHz pour tenir le tick 1 kHz + BT sans jitter.
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
