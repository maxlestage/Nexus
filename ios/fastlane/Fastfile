# Compilation et envoi sur TestFlight.
#
# L'authentification passe entièrement par la clé App Store Connect, fournie
# par trois secrets GitHub : ASC_ISSUER_ID, ASC_KEY_ID et ASC_KEY_P8. Aucun
# certificat n'est stocké dans le dépôt : Xcode crée et récupère lui-même le
# certificat et le profil grâce à cette clé (-allowProvisioningUpdates).

require "shellwords"

default_platform(:ios)

# Noms tentés pour la fiche App Store Connect, dans l'ordre. Un nom
# d'application est unique sur tout l'App Store : si « Nexus One » est déjà
# pris par quelqu'un d'autre, on essaie le suivant. La variable de dépôt
# APP_NAME court-circuite la liste.
APP_NAME_CANDIDATES = [
  ENV["APP_NAME"],
  "Nexus One",
  "Nexus One Manette",
  "Manette Nexus One"
].compact.reject(&:empty?).freeze

platform :ios do
  desc "Compile et envoie une version sur TestFlight"
  lane :beta do
    key_path = File.expand_path("../build/asc_key.p8", __dir__)
    app_identifier = ENV.fetch("BUNDLE_ID", "com.maximelestage.nexusone")

    api_key = app_store_connect_api_key(
      key_id: ENV.fetch("ASC_KEY_ID"),
      issuer_id: ENV.fetch("ASC_ISSUER_ID"),
      key_filepath: key_path,
      duration: 1200,
      in_house: false
    )

    ensure_app_record(key_path, app_identifier)

    # Numéro de build unique et croissant. Passé en réglage xcodebuild
    # plutôt que par agvtool, qui exige une configuration de versionnage
    # particulière du projet.
    build_number = ENV.fetch("GITHUB_RUN_NUMBER", Time.now.to_i.to_s)

    build_app(
      project: "NexusOne.xcodeproj",
      scheme: "NexusOne",
      configuration: "Release",
      export_method: "app-store",
      output_directory: "build",
      output_name: "NexusOne.ipa",
      clean: true,
      xcargs: [
        "CURRENT_PROJECT_VERSION=#{build_number}",
        "-allowProvisioningUpdates",
        "-authenticationKeyPath", key_path.shellescape,
        "-authenticationKeyID", ENV.fetch("ASC_KEY_ID").shellescape,
        "-authenticationKeyIssuerID", ENV.fetch("ASC_ISSUER_ID").shellescape
      ].join(" ")
    )

    upload_to_testflight(
      api_key: api_key,
      ipa: "build/NexusOne.ipa",
      skip_waiting_for_build_processing: true,
      changelog: ENV.fetch("CHANGELOG", "Build automatique depuis GitHub Actions.")
    )
  end

  desc "Compile sans signer — vérifie que le projet et le pont Rust tiennent"
  lane :check do
    xcodebuild(
      project: "NexusOne.xcodeproj",
      scheme: "NexusOne",
      configuration: "Debug",
      destination: "generic/platform=iOS Simulator",
      xcargs: "CODE_SIGNING_ALLOWED=NO build"
    )
  end
end

# Crée la fiche de l'application sur App Store Connect si elle n'existe pas
# encore : sans elle, l'envoi TestFlight échoue sur « Couldn't find app ».
# `produce` ne fait rien quand la fiche est déjà là.
#
# L'identifiant est déjà enregistré côté portail développeur par la signature
# automatique de Xcode, d'où skip_devcenter.
# Crée la fiche de l'application sur App Store Connect si elle n'existe pas
# encore : sans elle, l'envoi TestFlight échoue sur « Couldn't find app ».
#
# L'action « produce » ne convient pas ici : elle appelle
# Spaceship::ConnectAPI.login, qui remplace le client authentifié par clé par
# une connexion identifiant Apple + mot de passe. On passe donc directement
# par Spaceship, avec les mêmes appels que produce fait en interne.
#
# L'identifiant de bundle, lui, est déjà enregistré côté portail développeur
# par la signature automatique de Xcode.
def ensure_app_record(key_path, app_identifier)
  require "spaceship"

  Spaceship::ConnectAPI.auth(
    key_id: ENV.fetch("ASC_KEY_ID"),
    issuer_id: ENV.fetch("ASC_ISSUER_ID"),
    filepath: key_path
  )

  existing = Spaceship::ConnectAPI::App.find(app_identifier)
  if existing
    UI.success("Fiche « #{app_identifier} » déjà présente (#{existing.id}).")
    return
  end

  last_error = nil

  APP_NAME_CANDIDATES.each do |name|
    begin
      app = Spaceship::ConnectAPI::App.create(
        name: name,
        version_string: "1.0",
        sku: app_identifier,
        primary_locale: "fr-FR",
        bundle_id: app_identifier,
        platforms: [Spaceship::ConnectAPI::Platform::IOS]
      )
      UI.success("Fiche « #{name} » créée sur App Store Connect (#{app.id}).")
      wait_until_listed(app_identifier)
      return
    rescue StandardError => e
      last_error = e
      UI.important("Nom « #{name} » refusé : #{e.message.lines.first.to_s.strip}")
    end
  end

  UI.user_error!(<<~MSG)
    Impossible de créer la fiche « #{app_identifier} » sur App Store Connect.
    Dernière erreur : #{last_error&.message}

    Deux causes possibles :
      - tous les noms proposés sont déjà pris : définissez la variable de
        dépôt APP_NAME avec un nom libre ;
      - la clé App Store Connect n'a pas le rôle Admin ou App Manager :
        créez la fiche à la main avec l'identifiant ci-dessus.
  MSG
end

# App Store Connect met quelques secondes à référencer une fiche neuve. On
# n'échoue pas si elle tarde : la compilation qui suit dure plus longtemps
# que cette attente, et laisse donc à Apple le temps de suivre.
def wait_until_listed(app_identifier, attempts: 10, delay: 6)
  attempts.times do
    return if Spaceship::ConnectAPI::App.find(app_identifier)

    UI.message("La fiche n'est pas encore listée, nouvelle tentative…")
    sleep(delay)
  end

  UI.important("Fiche toujours pas listée ; on continue, la compilation laisse du temps à Apple.")
end
