# Compilation et envoi sur TestFlight.
#
# L'authentification passe entièrement par la clé App Store Connect, fournie
# par trois secrets GitHub : ASC_ISSUER_ID, ASC_KEY_ID et ASC_KEY_P8. Aucun
# certificat n'est stocké dans le dépôt : Xcode crée et récupère lui-même le
# certificat et le profil grâce à cette clé (-allowProvisioningUpdates).

require "shellwords"
require "fileutils"

default_platform(:ios)

# Noms tentés pour la fiche App Store Connect, dans l'ordre. Un nom
# d'application est unique sur tout l'App Store : si « Nexus One » est déjà
# pris par quelqu'un d'autre, on essaie le suivant. La variable de dépôt
# APP_NAME court-circuite la liste.
APP_NAME_CANDIDATES = [
  ENV["APP_NAME"],
  "Nexus One",
  "Nexus One Manette",
  "Manette Nexus One"
].compact.reject(&:empty?).freeze

platform :ios do
  desc "Compile et envoie une version sur TestFlight"
  lane :beta do
    key_path = File.expand_path("../build/asc_key.p8", __dir__)
    app_identifier = ENV.fetch("BUNDLE_ID", "com.maxlestage.nexusone")

    api_key = app_store_connect_api_key(
      key_id: ENV.fetch("ASC_KEY_ID"),
      issuer_id: ENV.fetch("ASC_ISSUER_ID"),
      key_filepath: key_path,
      duration: 1200,
      in_house: false
    )

    # Numéro de build unique et croissant. Passé en réglage xcodebuild
    # plutôt que par agvtool, qui exige une configuration de versionnage
    # particulière du projet.
    build_number = ENV.fetch("GITHUB_RUN_NUMBER", Time.now.to_i.to_s)

    build_app(
      project: "NexusOne.xcodeproj",
      scheme: "NexusOne",
      configuration: "Release",
      export_method: "app-store",
      output_directory: "build",
      output_name: "NexusOne.ipa",
      clean: true,
      xcargs: [
        "CURRENT_PROJECT_VERSION=#{build_number}",
        "-allowProvisioningUpdates",
        "-authenticationKeyPath", key_path.shellescape,
        "-authenticationKeyID", ENV.fetch("ASC_KEY_ID").shellescape,
        "-authenticationKeyIssuerID", ENV.fetch("ASC_ISSUER_ID").shellescape
      ].join(" ")
    )

    # Vérifiée après la compilation, et non avant : tant que la fiche manque,
    # le run échoue de toute façon — autant qu'il prouve d'abord que le projet
    # compile et qu'il dépose l'IPA en artefact.
    unless ensure_app_record(key_path, app_identifier)
      # Dernier chemin non exploré : le service de dépôt d'Apple n'est pas
      # l'API App Store Connect. C'est lui, et non fastlane, qui décide
      # d'accepter un binaire. On lui pose donc directement la question.
      direct_upload(app_identifier)
      next
    end

    upload_to_testflight(
      api_key: api_key,
      ipa: "build/NexusOne.ipa",
      skip_waiting_for_build_processing: true,
      changelog: ENV.fetch("CHANGELOG", "").lines.first.to_s.strip
        .then { |line| line.empty? ? "Build automatique depuis GitHub Actions." : line }
    )
  end

  desc "Compile sans signer — vérifie que le projet et le pont Rust tiennent"
  lane :check do
    xcodebuild(
      project: "NexusOne.xcodeproj",
      scheme: "NexusOne",
      configuration: "Debug",
      destination: "generic/platform=iOS Simulator",
      xcargs: "CODE_SIGNING_ALLOWED=NO build"
    )
  end
end

# Crée la fiche de l'application sur App Store Connect si elle n'existe pas
# encore : sans elle, l'envoi TestFlight échoue sur « Couldn't find app ».
# `produce` ne fait rien quand la fiche est déjà là.
#
# L'identifiant est déjà enregistré côté portail développeur par la signature
# automatique de Xcode, d'où skip_devcenter.
# Crée la fiche de l'application sur App Store Connect si elle n'existe pas
# encore : sans elle, l'envoi TestFlight échoue sur « Couldn't find app ».
#
# L'action « produce » ne convient pas ici : elle appelle
# Spaceship::ConnectAPI.login, qui remplace le client authentifié par clé par
# une connexion identifiant Apple + mot de passe. On passe donc directement
# par Spaceship, avec les mêmes appels que produce fait en interne.
#
# L'identifiant de bundle, lui, est déjà enregistré côté portail développeur
# par la signature automatique de Xcode.
def ensure_app_record(key_path, app_identifier)
  require "spaceship"

  Spaceship::ConnectAPI.auth(
    key_id: ENV.fetch("ASC_KEY_ID"),
    issuer_id: ENV.fetch("ASC_ISSUER_ID"),
    filepath: key_path
  )

  existing = Spaceship::ConnectAPI::App.find(app_identifier)
  if existing
    UI.success("Fiche « #{app_identifier} » déjà présente (#{existing.id}).")
    return true
  end

  last_error = nil

  APP_NAME_CANDIDATES.each do |name|
    begin
      app = Spaceship::ConnectAPI::App.create(
        name: name,
        version_string: "1.0",
        sku: app_identifier,
        primary_locale: "fr-FR",
        bundle_id: app_identifier,
        platforms: [Spaceship::ConnectAPI::Platform::IOS]
      )
      UI.success("Fiche « #{name} » créée sur App Store Connect (#{app.id}).")
      wait_until_listed(app_identifier)
      return true
    rescue StandardError => e
      last_error = e

      # Apple refuse la création aux clés qui n'ont pas le rôle voulu. Ce
      # n'est pas une question de nom : inutile d'essayer les suivants.
      return false if e.message.include?("does not allow 'CREATE'")

      UI.important("Nom « #{name} » refusé : #{e.message.lines.first.to_s.strip}")
    end
  end

  UI.user_error!(<<~MSG)
    Aucun des noms proposés n'a été accepté pour « #{app_identifier} ».
    Dernière erreur : #{last_error&.message}

    Un nom d'application est unique sur tout l'App Store. Définissez la
    variable de dépôt APP_NAME (Settings → Secrets and variables → Actions
    → Variables) avec un nom libre, puis relancez ce workflow.
  MSG
end

# Dépôt direct du binaire, sans passer par l'API App Store Connect.
#
# altool s'adresse au service de livraison d'Apple, qui est un autre système :
# c'est lui qui accepte ou refuse un binaire. Rien ne dit a priori qu'il exige
# la même fiche que l'API. Tant que la question n'a pas été posée à Apple, on
# ne peut pas conclure — alors on la pose.
def direct_upload(app_identifier)
  key_id = ENV.fetch("ASC_KEY_ID")
  issuer = ENV.fetch("ASC_ISSUER_ID")

  # altool cherche la clé sous un nom imposé, dans un dossier imposé.
  keys_dir = File.join(Dir.home, ".appstoreconnect", "private_keys")
  FileUtils.mkdir_p(keys_dir)
  installed_key = File.join(keys_dir, "AuthKey_#{key_id}.p8")
  FileUtils.cp(File.expand_path("../build/asc_key.p8", __dir__), installed_key)
  FileUtils.chmod(0o600, installed_key)

  UI.important("Fiche absente. Tentative de dépôt direct auprès du service de livraison d'Apple.")

  begin
    command = [
      "xcrun altool --upload-app",
      "-f build/NexusOne.ipa",
      "-t ios",
      "--apiKey #{key_id.shellescape}",
      "--apiIssuer #{issuer.shellescape}"
    ].join(" ")

    output = `#{command} 2>&1`
    succeeded = $?.success?
  ensure
    FileUtils.rm_f(installed_key)
  end

  UI.message(output.to_s.strip)

  if succeeded
    UI.success("Binaire accepté par Apple. La version apparaîtra dans TestFlight après traitement.")
    return
  end

  raise_manual_creation_needed(app_identifier, output.to_s)
end

# Seule issue restante quand ni l'API ni le dépôt direct n'acceptent le
# binaire : la fiche doit être créée depuis le site.
def raise_manual_creation_needed(app_identifier, delivery_output)
  UI.user_error!(<<~MSG)
    Les deux chemins possibles ont été essayés et refusés par Apple.

    1. Création par l'API App Store Connect :
       la ressource « apps » n'accepte que GET et UPDATE — la documentation
       d'Apple ne décrit aucune opération de création.

    2. Dépôt direct du binaire (altool), réponse du service de livraison :
       #{delivery_excerpt(delivery_output)}

    #{account_summary(app_identifier)}

    Sur https://appstoreconnect.apple.com → Apps → « + » → Nouvelle app :
      Plateformes ........ iOS
      Nom ................ Nexus One  (ou tout autre nom libre)
      Langue principale .. Français
      ID de package ...... #{app_identifier}
      SKU ................ #{app_identifier}

    Relancez ensuite ce workflow : tout le reste est automatique.
  MSG
end

# Retient les lignes qui portent le refus, ou à défaut la fin de la sortie :
# altool est bavard, et le motif exact varie d'une version à l'autre.
def delivery_excerpt(output)
  lines = output.to_s.lines.map(&:strip).reject(&:empty?)
  errors = lines.grep(/error|ERROR|\*\*\*/i)
  (errors.empty? ? lines.last(4) : errors.first(4)).join("\n       ")
end

# Décrit l'état réel du compte pour que le formulaire d'App Store Connect ne
# réserve aucune surprise : l'identifiant attendu figure-t-il bien dans la
# liste déroulante, et une fiche existe-t-elle déjà sous un autre nom ?
#
# Lecture seule : GET est la seule opération que l'API publique autorise ici.
def account_summary(app_identifier)
  lines = []

  begin
    ids = Spaceship::ConnectAPI::BundleId.all.map(&:identifier)
    if ids.include?(app_identifier)
      lines << "L'identifiant #{app_identifier} est bien enregistré : il"
      lines << "apparaîtra dans la liste « ID de package » du formulaire."
    else
      lines << "L'identifiant #{app_identifier} n'est PAS encore enregistré."
      lines << "Créez-le d'abord sur :"
      lines << "  https://developer.apple.com/account/resources/identifiers"
      lines << "Identifiants présents : #{ids.empty? ? 'aucun' : ids.join(', ')}"
    end
  rescue StandardError => e
    lines << "Liste des identifiants illisible : #{e.message.lines.first.to_s.strip}"
  end

  begin
    apps = Spaceship::ConnectAPI::App.all
    lines << ""
    if apps.empty?
      lines << "Aucune fiche n'existe encore sur ce compte."
    else
      lines << "Fiches déjà présentes sur le compte :"
      apps.each { |a| lines << "  #{a.name} — #{a.bundle_id}" }
      lines << "Si l'une d'elles est la bonne, définissez plutôt la variable"
      lines << "de dépôt BUNDLE_ID avec son identifiant."
    end
  rescue StandardError => e
    lines << "Liste des fiches illisible : #{e.message.lines.first.to_s.strip}"
  end

  lines.join("\n")
end
